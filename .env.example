# PulseVault AI — env template
# Copy to .env and fill in real values

GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
MONGO_URL=mongodb://mongo:27017
DB_NAME=pulsevault

# --- TTS ---
ELEVENLABS_API_KEY=your-elevenlabs-key-here
TTS_PROVIDER=elevenlabs        # elevenlabs | gtts
TTS_DEFAULT_VOICE=narrator
TTS_CACHE_DIR=media/tts

# --- Universal Ingest ---
YT_DLP_COOKIES_FILE=           # optional, for age-gated content
SPOTIFY_CLIENT_ID=             # for metadata cross-referencing
SPOTIFY_CLIENT_SECRET=
INGEST_MAX_DURATION_SECONDS=10800   # 3 hours cap

# --- Enrichment ---
HUNTER_IO_API_KEY=             # for guest contact discovery
